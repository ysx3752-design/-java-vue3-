# 复制为 .env 后按实际环境修改；.env 不会被提交

# 数据库（标准 JDBC 格式）
JDBC_URL=jdbc:mysql://localhost:3306/smart_agriculture?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true&zeroDateTimeBehavior=convertToNull&tinyInt1isBit=false
DB_USERNAME=root
DB_PASSWORD=your-password

# JWT 签名密钥：至少 32 字节，建议用随机串
JWT_SECRET_KEY=please-change-this-to-a-random-string-of-32-bytes-or-longer

# WSN 虚拟硬件网关地址
WSN_HOST=192.168.12.1
WSN_PORT=4000

# 历史数据采样间隔（秒），默认 120
# SENSOR_SAMPLE_SECONDS=120

# 是否在读取出口叠加昼夜波动（不写库），设为 false 返回网关原始读数
SENSOR_SIMULATE=true
